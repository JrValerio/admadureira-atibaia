# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.claude/
.playwright-mcp/
material_consulta/
*.pem

# material bruto de origem (fotos/vídeos não editados enviados para curadoria) —
# não deve ser commitado; só as artes já processadas em public/programacao vão pro repo.
public/images/aniversário-do-pastor/

# bundle de handoff exportado do Claude Design (runtime da ferramenta + uploads).
# O export bruto não entra no repo; achados que valham registro vão para docs/
# em markdown. O nome da pasta tem "maduereira" (sic): se ela for renomeada,
# atualizar este padrão junto.
docs/auditoria-adm-maduereira-atibaia/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Extrações locais de material de apoio (textos e PDFs das revistas)
tmp/

# Python
__pycache__/
